# 依赖
node_modules/
.pnpm-store/

# 构建产物
lib/
dist/
build/
*.tsbuildinfo

# ⚠ 例外：dsh-plugin/lib/ 是**手写源码**，不是构建产物。
# dsh 客户端插件第 1 步刻意不引入打包器（产物就是手写的 __ModuleLoader__ 包装），
# 所以这里的 .js 必须入库 —— 否则仓库里只剩一个空的壳，重装即丢。
# （2026-10-02：目录由 plugin/ 改名 dsh-plugin/，例外同步跟上；漏改会让源码被 lib/ 规则吃掉。）
!dsh-plugin/lib/

# .NET 构建产物（helper：exe / pdb / config / NuGet 还原物，全部可再生）
bin/
obj/
*.pdb

# 运行产物（local-mic 的 --selftest / --probe / --record 落盘 txt，--debug 的 debug/ 目录）
local-mic/*.txt
local-mic/debug/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 本地环境变量
.env
.env.local
.env.*.local

# 编辑器 / 系统
.vscode/
.idea/
.vs/
*.user
*.suo
.DS_Store
Thumbs.db

# 测试输出
coverage/
.vitest/

# 本地 Agent 工作台（会话笔记 / 草稿脚本 / 环境探针输出，只属于本机）
.workbuddy/

# 抓取的音频样本与原始帧（调试用，不入库）
samples/
*.wav
*.bin
